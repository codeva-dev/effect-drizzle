{
  "name": "@codeva-dev/effect-drizzle",
  "version": "0.1.0-alpha.2",
  "description": "Effect runtime integration for Drizzle clients.",
  "license": "MIT",
  "author": "Codeva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeva-dev/effect-drizzle.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run test && npm run build",
    "version:alpha": "npm version prerelease --preid alpha",
    "publish:alpha": "npm run check && npm publish --access public --tag alpha",
    "release:alpha": "npm run check && npm version prerelease --preid alpha && npm publish --access public --tag alpha"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1",
    "effect": ">=3.19.0 <4"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
