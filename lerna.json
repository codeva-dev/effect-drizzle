{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "0.1.0-alpha.1",
  "npmClient": "npm",
  "packages": [
    "."
  ],
  "command": {
    "version": {
      "allowBranch": "*",
      "conventionalCommits": true,
      "conventionalPrerelease": true,
      "message": "chore(release): publish %s",
      "preid": "alpha"
    },
    "publish": {
      "distTag": "alpha"
    }
  }
}